# Copy to .env and fill in APP_ENCRYPTION_KEY before the first run:
#
#   cp .env.example .env
#   make genkey            # prints a key; paste it below
#
# `make setup` does both steps for you.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# AES-256 key protecting TOTP secrets at rest. 32 bytes, base64 or hex encoded.
# Generate with `make genkey` or `docker compose run --rm --no-deps cli genkey`.
# Keep it out of version control. Rotating it makes existing 2FA secrets
# undecryptable, so enrolled users would have to re-enrol.
APP_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Database (used by both the postgres container and the CLI's DATABASE_URL)
# ---------------------------------------------------------------------------

POSTGRES_DB=clilogin
POSTGRES_USER=app
POSTGRES_PASSWORD=change_me_in_dotenv

# ---------------------------------------------------------------------------
# Password storage
# ---------------------------------------------------------------------------

# bcrypt work factor, 10-31. Each +1 doubles the hashing time. 12 is roughly
# 250ms on modern hardware — slow enough to hurt offline cracking, fast enough
# for an interactive login.
BCRYPT_COST=12

# Shortest password accepted. Length is the policy that matters; there are
# deliberately no character-class rules (see the README's security notes).
MIN_PASSWORD_LENGTH=10

# ---------------------------------------------------------------------------
# Account lockout
# ---------------------------------------------------------------------------

# Consecutive failed authentication steps (wrong password OR wrong 2FA code)
# tolerated before the account locks.
MAX_FAILED_ATTEMPTS=5

# How long the account stays locked. Accepts Go durations: 30s, 15m, 2h.
LOCKOUT_DURATION=15m

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# Sliding inactivity window: every authenticated command pushes it forward.
SESSION_IDLE_TIMEOUT=15m

# Hard cap on total session lifetime, regardless of activity. Must be >= the
# idle timeout.
SESSION_ABSOLUTE_TIMEOUT=12h

# Cache the session token on disk so a session survives restarting the CLI.
# Set false to require a fresh login on every start.
SESSION_PERSIST=true

# Where the token cache and command history live. Defaults to ~/.cli-login;
# the container image sets /home/app/.cli-login.
# STATE_DIR=/home/app/.cli-login

# ---------------------------------------------------------------------------
# Two-factor authentication
# ---------------------------------------------------------------------------

# Label shown next to the account in the authenticator app.
TOTP_ISSUER=CLI Login

# 30-second steps accepted either side of now, to tolerate clock drift.
# 1 means the previous, current and next code are valid (~90s window).
TOTP_SKEW=1

# How long a half-finished login (password accepted, 2FA outstanding) stays
# valid before you have to start again.
PENDING_LOGIN_TTL=2m

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------

# debug | info | warn | error. Logs go to stderr, keeping stdout clean for the
# shell transcript.
LOG_LEVEL=warn

# Timezone used when rendering timestamps in the user-details block.
TZ=UTC

# How long to keep retrying the initial database connection at startup.
DB_CONNECT_TIMEOUT=30s
